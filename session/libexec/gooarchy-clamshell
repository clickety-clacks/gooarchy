#!/bin/bash
# Gooarchy: clamshell mode for laptops. With the lid closed while an external display is in use,
# the laptop panel is turned off; with the lid open (or nothing external in use) it comes back at
# the scale and position it had. A laptop display the user turned off themselves is left off while
# an external display is in use. Scottland's lid switch binding runs this on every lid change, and
# the session runs it once at start (see 35-gooarchy-lid and autostart.d/45-gooarchy-clamshell).
#
# It talks to Scottland directly: displays are turned off and on through Scottland's output control
# (scottland-output), whose settings live in the session's config, so turning the panel off keeps
# its mode, position and scale and turning it on restores them.
#
# Derived from Omarchy's bin/omarchy-hyprland-monitor-clamshell at commit
# 9285b19d6a72eba3df8537d62a4cd5506a803d89 (the version Omarchy 4.0.4 ships), which does the same
# for Hyprland through hyprctl and Hyprland's config. Changed: the Hyprland toggle files, `hyprctl
# reload`/`eval` and the scale bookkeeping are replaced by scottland-output, which keeps a panel's
# settings while it is off; the hardware checks (lid state, connected connectors) and the
# laptop-panel names are Omarchy's.
#
# Omarchy's copyright and license notice:
#
#   Copyright (c) David Heinemeier Hansson
#
#   Permission is hereby granted, free of charge, to any person obtaining
#   a copy of this software and associated documentation files (the
#   "Software"), to deal in the Software without restriction, including
#   without limitation the rights to use, copy, modify, merge, publish,
#   distribute, sublicense, and/or sell copies of the Software, and to
#   permit persons to whom the Software is furnished to do so, subject to
#   the following conditions:
#
#   The above copyright notice and this permission notice shall be
#   included in all copies or substantial portions of the Software.
#
#   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
#   EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
#   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
#   NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
#   LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
#   OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
#   WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.

HOOKS="${SCOTTLAND_HOOKS:-/usr/lib/scottland}"
OUTPUT="$HOOKS/libexec/scottland-output"
POWER="$HOOKS/libexec/scottland-output-power"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gooarchy/clamshell"
# This script turned the panel off (its name inside); without it, a panel that is off was turned
# off by the user.
CLAMSHELL_FLAG="$STATE_DIR/panel-off"
DRM_PATH="${GOOARCHY_DRM_PATH:-/sys/class/drm}"
INTERNAL_NAME='^(eDP|LVDS|DSI)-'

if [[ ! -x $OUTPUT ]]; then
  echo "gooarchy-clamshell: this Scottland has no output control ($OUTPUT)" >&2
  exit 1
fi

mkdir -p "$STATE_DIR"
# Lid events can come quickly; one reconcile at a time, each seeing the last one's result.
exec 9>"$STATE_DIR/lock"
flock 9

OUTPUTS=$("$OUTPUT" list) || exit 1

# The built-in laptop display, including when it is off.
INTERNAL=$(jq -r --arg internal "$INTERNAL_NAME" '.[] | select(.name | test($internal)).name' <<<"$OUTPUTS" | head -n 1)

# INTERNAL is passed on to scottland-output; only a plain connector name may pass.
if [[ -n $INTERNAL && ! $INTERNAL =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Refusing unsafe internal monitor name" >&2
  exit 1
fi

# The lid is closed (as Omarchy's omarchy-hw-laptop-closed reads it).
laptop_closed() {
  local state
  for state in /proc/acpi/button/lid/*/state; do
    [[ -r $state ]] || continue
    [[ $(<"$state") == *"closed"* ]] && return 0
  done
  return 1
}

# An external display is physically connected (as Omarchy's omarchy-hw-external-monitors reads it).
external_connected() {
  local status
  for status in "$DRM_PATH"/card*-*/status; do
    [[ -e $status ]] || continue
    [[ $status =~ -(eDP|LVDS|DSI)-[^/]+/status$ ]] && continue
    [[ $(<"$status") == "connected" ]] && return 0
  done
  return 1
}

# An external display is on in Scottland.
external_active() {
  jq -e --arg internal "$INTERNAL_NAME" \
    '.[] | select(.name | test($internal) | not) | select(.enabled == true)' <<<"$OUTPUTS" >/dev/null
}

internal_enabled() {
  jq -e --arg name "$INTERNAL" '.[] | select(.name == $name and .enabled == true)' <<<"$OUTPUTS" >/dev/null
}

enable_internal() {
  [[ -n $INTERNAL ]] || return 0

  if [[ -f $CLAMSHELL_FLAG ]]; then
    rm -f "$CLAMSHELL_FLAG"
  elif internal_enabled || external_active; then
    # On already, or off by the user's own choice while another display is in use: leave it.
    return 0
  fi
  # Turned off by the lid, or off with nothing else to show the desktop on: on again, with the
  # mode, position and scale its settings still hold.
  internal_enabled || "$OUTPUT" set "$INTERNAL" --on >/dev/null || true
  "$POWER" --output "$INTERNAL" on >/dev/null 2>&1 || true
}

disable_internal() {
  [[ -n $INTERNAL ]] || exit 0
  # Off already and not by this script: the user turned it off; leave it to them.
  if ! internal_enabled; then
    return 0
  fi

  printf '%s\n' "$INTERNAL" >"$CLAMSHELL_FLAG"
  "$OUTPUT" set "$INTERNAL" --off >/dev/null || rm -f "$CLAMSHELL_FLAG"
}

if laptop_closed && external_connected && external_active; then
  disable_internal
else
  enable_internal
fi
