# xdg-desktop-portal-wlr from our own fork, clickety-clacks/xdg-desktop-portal-wlr: upstream 0.8.4
# with two screen-sharing fixes, released as v0.8.4-gooarchy.1 (docs/xdg-desktop-portal-wlr.md).
# Arch's own package (upstream 0.8.4) loses shared streams under Wayfire. This one stands in for
# it (provides/conflicts), so packages that depend on xdg-desktop-portal-wlr take it.
#   keep an in-flight capture across a pause: a pause while a capture is in flight (GStreamer
#         consumers do this at start) made the portal start a second ext-image-copy-capture
#         frame (a protocol error that ends the stream) or hand the consumer an unfinished buffer
#         with a zero timestamp, after which GStreamer waits for a clock time a machine's uptime
#         away and the stream starves.
#   don't destroy the process retry timer twice: closing a session while the stream is starved
#         of buffers crashed the portal.
# Packaging follows Arch's xdg-desktop-portal-wlr PKGBUILD.
pkgname=xdg-desktop-portal-wlr-gooarchy
_pkgname=xdg-desktop-portal-wlr
_upstreamver=0.8.4
_tag=v$_upstreamver-gooarchy.1
pkgver=$_upstreamver.gooarchy.1
pkgrel=1
pkgdesc='xdg-desktop-portal backend for wlroots (Gooarchy fork, with screen-sharing fixes)'
arch=('x86_64' 'aarch64')
url="https://github.com/clickety-clacks/xdg-desktop-portal-wlr"
license=('MIT')
depends=(
  'glibc'
  'grim'
  'libdrm'
  'libinih'
  'libpipewire'
  'mesa'
  'pipewire'
  'pipewire-session-manager'
  'slurp'
  'systemd-libs'
  'wayland'
  'xdg-desktop-portal'
)
makedepends=(
  'meson'
  'scdoc'
  'wayland-protocols'
)
provides=("$_pkgname=$_upstreamver" 'xdg-desktop-portal-impl')
conflicts=("$_pkgname")
source=(
  "$_pkgname-${_tag#v}.tar.gz::$url/archive/$_tag/$_pkgname-${_tag#v}.tar.gz"
  wlr-portals.conf
)
sha512sums=('3f6b012de51b7494baeea6de03ba9b8594885707ef8d7ecf135bf9eb597e2ec61a1fe0d670e611ce342a84482e4ca5195532977c2edadabb491e03f505fd073c'
            '71f3383c3f62100dc669c519d107614a4566e808deddf66a179dd2bf175dc272a2390965cf38cd11dc4f0db0dc5cc7104712805034b9bced5874d62b03a579c2')

build() {
  cd "$_pkgname-${_tag#v}"
  arch-meson -Dsd-bus-provider=libsystemd build
  ninja -C build
}

package() {
  cd "$_pkgname-${_tag#v}"
  DESTDIR="$pkgdir" ninja -C build install
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  # fix detection with x-d-p 1.18 (as Arch's package does)
  install -vDm644 -t "$pkgdir/usr/share/xdg-desktop-portal" "$srcdir/wlr-portals.conf"
}
