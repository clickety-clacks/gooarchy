pkgbase=agentd
pkgname=('agentd' 'agentd-attention')
pkgver=0.3.5
pkgrel=1
pkgdesc='Truthful local coding-agent registry and event stream'
arch=('x86_64')
url='https://github.com/clickety-clacks/agentd'
license=('MIT')

_release_dir="${pkgbase}-${pkgver}-x86_64-unknown-linux-gnu"
_readme_commit='4549754e2bada5b6ca2f5ff9f92ea0f5066b4fab'
_readme_source="agentd-README-${_readme_commit}.md"
_license_commit='d4227bc69ceb5fb29f41b7f12692569ee75d3619'
_license_source="agentd-LICENSE-${_license_commit}.txt"

source=(
  "${_release_dir}.tar.gz::${url}/releases/download/v${pkgver}/${_release_dir}.tar.gz"
  "${_readme_source}::https://raw.githubusercontent.com/clickety-clacks/agentd/${_readme_commit}/README.md"
  "${_license_source}::https://raw.githubusercontent.com/clickety-clacks/agentd/${_license_commit}/LICENSE"
  'agentd.service'
  'agentd-attention.service'
)
sha256sums=(
  'dc1fe4109c5596d4f69c79c5f60b8e39277446fcef45b731e66c44d327050387'
  'a8fa5098ca56f4b40c086edd41dfe456366567f4b43d50b2f20e62adfecafdc0'
  'b1ed28e369c287a7b3dd0c94ba46a5c9a090c8164c32244f5cc63c4d0fa3631d'
  '4b021e482ba503d94630da8a4874898204e1d0f62224ad81588f7cd1371e80d2'
  'f05b90f7d0f9b6231a32730c6809d6ecc08d7a3c1cde0a6039230666a084c3ad'
)

package_agentd() {
  depends=('gcc-libs' 'glibc' 'systemd')
  optdepends=('agentd-attention: optional local attention bridge')

  install -Dm755 "$srcdir/$_release_dir/agentd" "$pkgdir/usr/bin/agentd"
  install -Dm644 "$srcdir/agentd.service" \
    "$pkgdir/usr/lib/systemd/user/agentd.service"
  install -Dm644 "$srcdir/$_readme_source" \
    "$pkgdir/usr/share/doc/agentd/README.md"
  install -Dm644 "$srcdir/$_license_source" \
    "$pkgdir/usr/share/licenses/agentd/LICENSE"
}

package_agentd-attention() {
  pkgdesc='Optional local attention bridge for Agentd'
  depends=("agentd=${pkgver}-${pkgrel}")

  install -Dm755 "$srcdir/$_release_dir/agentd-attention" \
    "$pkgdir/usr/bin/agentd-attention"
  install -Dm644 "$srcdir/$_release_dir/docs/agentd-attention.md" \
    "$pkgdir/usr/share/doc/agentd-attention/agentd-attention.md"
  install -Dm644 "$srcdir/agentd-attention.service" \
    "$pkgdir/usr/lib/systemd/user/agentd-attention.service"
  install -Dm644 "$srcdir/$_license_source" \
    "$pkgdir/usr/share/licenses/agentd-attention/LICENSE"
}
