# Gooarchy's own package, built from this repository. install/packaging/gooarchy.sh builds it
# during install; by hand: cd packaging/arch && makepkg.
#   gooarchy  the distro: the tty1 session start and its helpers, and dependencies on everything
#             Gooarchy is made of (removing it takes them along)
# gooarchy-flavorings, the curated defaults, has its own recipe in packaging/gooarchy-flavorings/.
#
# This is a local build of a checkout, not a self-contained source package: package() reads the
# checkout ($GOOARCHY_PATH, or two levels up) directly, so makepkg --source would not capture it.
# /usr/share/gooarchy/build-info records exactly what went in (checkout revision and uncommitted
# changes), and a checkout with uncommitted changes gets
# ".dirty" in its version. A source package that builds anywhere comes with the package repository.
pkgbase=gooarchy
pkgname=gooarchy
_repo=${GOOARCHY_PATH:-$startdir/../..}
_dirty=$(git -C "$_repo" status --porcelain 2>/dev/null | grep -q . && echo .dirty || true)
pkgver=0.0.1.r$(git -C "$_repo" rev-list --count HEAD 2>/dev/null || echo 0).g$(git -C "$_repo" rev-parse --short HEAD 2>/dev/null || echo none)$_dirty
pkgrel=1
pkgdesc="Gooarchy, a desktop Linux distribution built around Scottland"
arch=('any')
url="https://github.com/clickety-clacks/gooarchy"
license=('LicenseRef-unlicensed')
makedepends=('git')
options=('!debug')

package() {
  depends=('scottland' 'strata-bin' 'gooarchy-flavorings'
           $(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$_repo/install/gooarchy-base.packages"))
  install -Dm644 "$_repo/session/gooarchy-session.sh" "$pkgdir/etc/profile.d/gooarchy-session.sh"
  install -Dm755 "$_repo/session/libexec/gooarchy-session-cleanup" "$pkgdir/usr/lib/gooarchy/gooarchy-session-cleanup"
  install -Dm755 "$_repo/session/30-gooarchy-keyboard" "$pkgdir/usr/lib/scottland/config.d/30-gooarchy-keyboard"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/gooarchy/build-info" <<INFO
gooarchy $pkgver
checkout $(git -C "$_repo" rev-parse HEAD 2>/dev/null || echo unknown)${_dirty:+ with uncommitted changes}
built $(date -u +%Y-%m-%dT%H:%M:%SZ)
INFO
}
