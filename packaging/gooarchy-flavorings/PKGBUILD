# gooarchy-flavorings: Gooarchy's curated defaults and the Watercolor Dream themes, built from the
# gooarchy-flavorings repository at the final tag pinned here. Gooarchy and Scottland's Omarchy
# adapter install this same package. It needs nothing from a gooarchy or Scottland checkout, so
# this file can be built on its own: makepkg in a directory holding only it.
#
# Keep this final upstream tag and package version aligned. RCs, branches, and raw commits are
# unsupported source selectors.
pkgname=gooarchy-flavorings
_tag=v0.2.1
pkgver=0.2.1
pkgrel=1
# Expected identity for the selected final tag. These values validate the tag and any imported
# package receipt; _tag remains the sole source selector.
_upstream_commit=a7107415e39be00fb50745788c17429932bf6829
_upstream_tree=d1ec6a0ded81b8e4cb8ccb167a8679fb9f8542b6
_upstream_archive_sha256=722d4cf2f83c2f1f16e27e0a2e1105a28cf46716025bf1f290565df6300763af
pkgdesc="Gooarchy's curated defaults for Scottland and its apps"
arch=('any')
url="https://github.com/clickety-clacks/gooarchy-flavorings.git"
license=('LicenseRef-unlicensed')
# Runtime needs of what it installs. Building needs only git and Python (and base-devel), not
# Scottland: on a machine without Scottland yet, build with makepkg --nodeps (see the README).
depends=('scottland' 'python' 'glib2' 'gsettings-desktop-schemas' 'dconf' 'swaybg' 'webp-pixbuf-loader'
         'xdg-user-dirs' 'grim' 'slurp')
optdepends=('ghostty: themed terminal' 'chromium: browser (system title bar)'
            'strata-bin: file manager' 'tmux: titled terminal sessions')
makedepends=('git' 'python')
backup=('etc/tmux.conf')
options=('!debug')

_recipe=${BASH_SOURCE[0]}
_tag_count=$(grep -c '^_tag=' "$_recipe" || true)
_commit_count=$(grep -c '^_commit=' "$_recipe" || true)
_branch_count=$(grep -c '^_branch=' "$_recipe" || true)
if [[ $_tag_count == 1 && $_commit_count == 0 && $_branch_count == 0 &&
      $_tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] &&
   git check-ref-format "refs/tags/$_tag"; then
  _flavorings_source_ref="#tag=$_tag"
else
  echo "Set exactly one final version _tag (vMAJOR.MINOR.PATCH) in the gooarchy-flavorings recipe; raw commit, branch, RC, and missing pins are unsupported." >&2
  exit 1
fi

source=("gooarchy-flavorings::git+$url$_flavorings_source_ref")
sha256sums=('SKIP')

package() {
  local source_dir="$srcdir/gooarchy-flavorings" resolved_commit resolved_tree
  resolved_commit=$(git -C "$source_dir" rev-parse HEAD) || {
    echo "Could not resolve the checked-out gooarchy-flavorings source commit." >&2
    return 1
  }
  resolved_tree=$(git -C "$source_dir" rev-parse 'HEAD^{tree}') || {
    echo "Could not resolve the checked-out gooarchy-flavorings source tree." >&2
    return 1
  }
  [[ $resolved_commit == "$_upstream_commit" && $resolved_tree == "$_upstream_tree" ]] || {
    echo "The selected gooarchy-flavorings tag does not resolve to its recorded source identity." >&2
    return 1
  }
  make -C "$source_dir" install DESTDIR="$pkgdir"
}
